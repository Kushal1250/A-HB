{
  "name": "anu-birthday-local",
  "version": "6.0.0",
  "private": true,
  "scripts": {
    "prestart": "node scripts/check-node.mjs",
    "start": "npm run build && node server/src/index.js",
    "dev": "npm start",
    "install:all": "node scripts/check-node.mjs && npm ci --prefix client && npm ci --prefix server",
    "build": "npm run build --prefix client",
    "test": "npm test --prefix server && npm test --prefix client",
    "admin:create": "node server/scripts/create-admin.js",
    "pretest": "npm run build",
    "deploy:seed": "node scripts/prepare-seed.mjs",
    "add:videos": "node scripts/add-memory-videos.mjs"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
