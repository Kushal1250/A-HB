# Local use needs NO environment variables.
# Birthday data is stored in data/birthday.json and data/uploads/.
#
# On Render (see docs/DEPLOYMENT.md) set these in the dashboard instead:
#   NODE_ENV=production
#   FRONTEND_ORIGINS=https://your-site.vercel.app     (no trailing slash, no path)
#   ADMIN_EMAIL=you@example.com                       (creates the /admin login)
#   ADMIN_PASSWORD=a-long-password-12-to-256-chars
#   DATA_DIR=/var/data                                (only with a paid persistent disk)
